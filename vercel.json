{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron-triage", "schedule": "0 18 * * *" },
    { "path": "/api/cron-firms", "schedule": "0 */6 * * *" }
  ]
}

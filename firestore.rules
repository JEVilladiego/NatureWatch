rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Helpers ----------
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // An official has an officials/{uid} document (created by an admin in the Console)
    // or a custom role claim. Email addresses are NEVER trusted.
    function isOfficial() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/officials/$(request.auth.uid)) ||
        request.auth.token.role == 'official' ||
        request.auth.token.role == 'admin'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCategory(cat) {
      return cat in [
        'solid_waste',
        'water_pollution',
        'air_pollution_burning',
        'illegal_logging_vegetation',
        'illegal_quarrying_extraction',
        'wildlife',
        'noise_other',
        'other',
        'not_environmental'
      ];
    }

    function isValidStatus(status) {
      return status in ['pending', 'in_progress', 'resolved', 'spam'];
    }

    function isValidLocation(loc) {
      return loc is map &&
        loc.keys().hasAll(['lat', 'lng', 'geohash', 'source']) &&
        loc.keys().hasOnly(['lat', 'lng', 'accuracyMeters', 'geohash', 'source', 'municipality', 'barangay', 'landmark']) &&
        loc.lat is number && loc.lat >= -90 && loc.lat <= 90 &&
        loc.lng is number && loc.lng >= -180 && loc.lng <= 180 &&
        loc.geohash is string && loc.geohash.size() <= 12 &&
        loc.source in ['gps', 'manual_pin'] &&
        (!('accuracyMeters' in loc) || loc.accuracyMeters == null || loc.accuracyMeters is number) &&
        (!('municipality' in loc) || (loc.municipality is string && loc.municipality.size() <= 64)) &&
        (!('barangay' in loc) || (loc.barangay is string && loc.barangay.size() <= 64)) &&
        (!('landmark' in loc) || (loc.landmark is string && loc.landmark.size() <= 128));
    }

    // ---------- Reports ----------
    function isValidReportCreate(data) {
      return data.keys().hasAll([
        'referenceCode',
        'createdAt',
        'status',
        'statusHistory',
        'location',
        'rawInput',
        'triageStatus'
      ]) &&
      data.keys().hasOnly([
        'referenceCode',
        'createdAt',
        'status',
        'statusHistory',
        'location',
        'rawInput',
        'triageStatus',
        'isSpam'
      ]) &&
      data.referenceCode is string && data.referenceCode.matches('^BK-[A-Z0-9]{5}$') &&
      data.createdAt == request.time &&
      data.status == 'pending' &&
      data.triageStatus == 'pending' &&
      data.rawInput is map &&
      data.rawInput.keys().hasOnly(['description', 'hasImage', 'imageCount', 'captureMethod', 'exif']) &&
      data.rawInput.description is string &&
      data.rawInput.description.size() <= 500 &&
      data.rawInput.hasImage is bool &&
      (!('imageCount' in data.rawInput) || data.rawInput.imageCount is int) &&
      (!('captureMethod' in data.rawInput) || data.rawInput.captureMethod in ['live_camera', 'gallery', 'mixed']) &&
      (!('exif' in data.rawInput) || data.rawInput.exif == null || data.rawInput.exif is map) &&
      isValidLocation(data.location) &&
      data.statusHistory is list &&
      data.statusHistory.size() == 1 &&
      data.statusHistory[0].status == 'pending';
    }

    function isValidReportUpdate() {
      let diffKeys = incoming().diff(existing()).affectedKeys();
      return isOfficial() &&
        diffKeys.hasOnly(['status', 'statusHistory', 'final', 'isSpam']) &&
        isValidStatus(incoming().status) &&
        incoming().statusHistory is list &&
        incoming().statusHistory.size() >= existing().statusHistory.size() &&
        incoming().statusHistory.size() <= 25 &&
        (
          !('final' in incoming()) ||
          incoming().final == null ||
          (
            incoming().final is map &&
            incoming().final.keys().hasOnly(['category', 'severity', 'reviewedBy', 'reviewedAt', 'notes']) &&
            isValidCategory(incoming().final.category) &&
            incoming().final.severity is int &&
            incoming().final.severity >= 1 &&
            incoming().final.severity <= 5 &&
            incoming().final.reviewedBy == request.auth.uid &&
            incoming().final.notes is string &&
            incoming().final.notes.size() <= 1000
          )
        );
    }

    match /reports/{reportId} {
      // Anyone (anonymous residents) can submit a report meeting strict constraints
      allow create: if isValidId(reportId) && isValidReportCreate(incoming());

      // Only officials can read reports (public lookups go through /api/status)
      allow get, list: if isOfficial();

      // Only officials can update status, statusHistory, and final
      allow update: if isValidId(reportId) && isValidReportUpdate();

      // Officials can permanently delete confirmed spam / troll reports
      allow delete: if isOfficial();
    }

    // ---------- Report photos (compressed base64, separate from the report) ----------
    match /report_images/{reportId} {
      // Must be written in the same batch as its report
      allow create: if isValidId(reportId) &&
        existsAfter(/databases/$(database)/documents/reports/$(reportId)) &&
        !exists(/databases/$(database)/documents/report_images/$(reportId)) &&
        incoming().keys().hasOnly(['data', 'mimeType', 'createdAt', 'images']) &&
        incoming().keys().hasAll(['data', 'mimeType', 'createdAt']) &&
        incoming().data is string &&
        incoming().data.size() <= 800000 &&
        incoming().data.matches('^data:image/jpeg;base64,.*') &&
        incoming().mimeType == 'image/jpeg' &&
        incoming().createdAt == request.time &&
        (!('images' in incoming()) || incoming().images is list);

      allow get: if isOfficial();
      allow list: if false;
      allow update: if false;
      allow delete: if isOfficial();
    }

    // ---------- Officials ----------
    // Managed only from the Firebase Console / Admin SDK.
    match /officials/{officialId} {
      allow get: if isSignedIn() && request.auth.uid == officialId;
      allow list: if isOfficial();
      allow write: if false;
    }
  }
}

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model identifier for server-side triage (Flash-class model)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Cloud & Admin Configuration (optional in development; uses ADC or mock/applet config if omitted)
FIREBASE_PROJECT_ID="sound-landing-8zbz0"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@sound-landing-8zbz0.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

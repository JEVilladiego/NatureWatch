rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{reportId}/{fileName} {
      // Allow upload only if image and <= 2MB
      allow create: if request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // No public read directly; officials access via short-lived signed URLs from backend proxy
      allow read: if request.auth != null && (
        request.auth.token.role == 'official' ||
        request.auth.token.email == 'johnedwardvvilladiego@gmail.com'
      );
      allow update, delete: if false;
    }
  }
}
